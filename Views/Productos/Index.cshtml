@model ProductoViewModel
@inject SignInManager<ApplicationUser> SignInManager
@{
    ViewData["Title"] = "Catálogo de productos";
    var busquedaActiva = !string.IsNullOrWhiteSpace(Model.Busqueda);
}

<div class="page-head">
    <span class="eyebrow">Tienda</span>
    <h1 class="display-4 mt-2 mb-2">Catálogo de productos</h1>
    <p>Todo lo que tu mascota necesita: alimentos, accesorios, juguetes y más.</p>
</div>

<form asp-action="Index" asp-controller="Productos" method="get" role="search" class="d-flex gap-2 align-items-center mt-3">
    <input type="search" name="busqueda" value="@Model.Busqueda" class="form-control flex-grow-1"
           placeholder="Buscar producto por nombre..." aria-label="Buscar producto por nombre" autofocus="@busquedaActiva" />
    <input type="hidden" name="categoriaId" value="@Model.CategoriaId" />
    <button type="submit" class="btn btn-brand">Buscar</button>
</form>

<div class="filter-bar d-flex flex-wrap align-items-center gap-2 mt-3">
    <span class="eyebrow me-1">Filtrar por categoría</span>
    <a asp-action="Index" asp-route-busqueda="@Model.Busqueda" class="filter-chip @(Model.CategoriaId is null ? "active" : "")">Todos</a>
    @foreach (var categoria in Model.Categorias)
    {
        <a asp-action="Index" asp-route-categoriaId="@categoria.Id" asp-route-busqueda="@Model.Busqueda"
           class="filter-chip @(Model.CategoriaId == categoria.Id ? "active" : "")">@categoria.Nombre</a>
    }
    @if (busquedaActiva && Model.AlgoliaResult is not null)
    {
        <span class="ms-auto text-muted small">@Model.AlgoliaResult.NbHits @(Model.AlgoliaResult.NbHits == 1 ? "resultado" : "resultados") en Algolia</span>
    }
    else
    {
        <span class="ms-auto text-muted small">@Model.Productos.Count @(Model.Productos.Count == 1 ? "producto" : "productos")</span>
    }
</div>

@if (TempData["AlgoliaSync"] is not null)
{
    <div class="alert alert-success mt-3 mb-0" role="alert">@TempData["AlgoliaSync"]</div>
}

@if (!Model.Productos.Any())
{
    <div class="card p-5 text-center mt-3">
        @if (busquedaActiva)
        {
            <p class="mb-2 fs-4">No se encontraron productos con "<strong>@Model.Busqueda</strong>".</p>
            <div class="d-flex gap-2 justify-content-center">
                <p class="text-muted mb-0">Revisa la ortografía o prueba con otro nombre.</p>
                @if (User.IsInRole("Admin"))
                {
                    <form asp-action="SyncAlgolia" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-link p-0 align-baseline">Sincronizar índice</button>
                    </form>
                }
            </div>
        }
        else if (Model.CategoriaId is not null)
        {
            <p class="mb-2 fs-4">No hay productos en esta categoría.</p>
            <p class="text-muted mb-0">Prueba con otra categoría.</p>
        }
        else
        {
            <p class="mb-2 fs-4">No hay productos por ahora.</p>
            <p class="text-muted mb-0">Agrega productos a la base de datos.</p>
        }
    </div>
}

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4 mt-1">
    @foreach (var producto in Model.Productos)
    {
        <div class="col">
            <div class="card card-hover product-card h-100 overflow-hidden position-relative">
                <span class="badge-cat">@producto.Categoria?.Nombre</span>
                <img src="@producto.ImagenUrl" class="card-img-top" alt="@producto.Nombre" loading="lazy" />
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title">@producto.Nombre</h5>
                    <p class="card-text text-muted flex-grow-1">@producto.Descripcion</p>
                    <div class="d-flex justify-content-between align-items-center mt-2">
                        <span class="price-pill">S/ @producto.Precio.ToString("0.00")</span>
                        <span class="small text-muted">@(producto.SinStock ? "Sin stock" : $"Stock: {producto.Stock}")</span>
                    </div>
                </div>
                <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                    <button type="button" class="btn btn-brand w-100" @(producto.SinStock ? "disabled" : "")>Agregar al carrito</button>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        var recordado = Model.Recordados.Contains(producto.Id);
                        <form asp-controller="Productos" asp-action="@(recordado ? "NoRecordar" : "Recordar")" method="post" class="mt-2"
                              data-recordar="@(recordado ? "NoRecordar" : "Recordar")" data-id="@producto.Id">
                            <input type="hidden" name="id" value="@producto.Id" />
                            <button type="submit" class="btn btn-@(recordado ? "sun" : "ghost") w-100">
                                @(recordado ? "Quitar de recordados" : "Recordar")
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    }
</div>

@if (busquedaActiva && Model.AlgoliaResult is not null && Model.AlgoliaResult.NbPages > 1)
{
    <nav aria-label="Paginación de resultados" class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Model.AlgoliaResult.Page > 0)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-busqueda="@Model.Busqueda"
                       asp-route-categoriaId="@Model.CategoriaId" asp-route-page="@(Model.AlgoliaResult.Page - 1)">Anterior</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Anterior</span></li>
            }
            @for (var i = 0; i < Model.AlgoliaResult.NbPages; i++)
            {
                <li class="page-item @(i == Model.AlgoliaResult.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-busqueda="@Model.Busqueda"
                       asp-route-categoriaId="@Model.CategoriaId" asp-route-page="@i">@(i + 1)</a>
                </li>
            }
            @if (Model.AlgoliaResult.Page < Model.AlgoliaResult.NbPages - 1)
            {
                <li class="page-item">
                    <a class="page-link" asp-action="Index" asp-route-busqueda="@Model.Busqueda"
                       asp-route-categoriaId="@Model.CategoriaId" asp-route-page="@(Model.AlgoliaResult.Page + 1)">Siguiente</a>
                </li>
            }
            else
            {
                <li class="page-item disabled"><span class="page-link">Siguiente</span></li>
            }
        </ul>
    </nav>
}