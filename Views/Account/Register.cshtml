@model RegisterViewModel
@{
    ViewData["Title"] = "Registrarse";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="page-head">
    <span class="eyebrow">Nueva cuenta</span>
    <h1 class="display-4 mt-2 mb-2">Crear cuenta</h1>
    <p>Únete a Mundo Mascota y accede a todos nuestros beneficios.</p>
</div>

<div class="row g-4 mt-1">
    <div class="col-lg-7">
        <div class="card p-4 p-lg-5">
            <form asp-controller="Account" asp-action="Register" method="post" asp-route-returnurl="@returnUrl" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="tucorreo@ejemplo.com" autofocus />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" type="password" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-brand btn-lg px-4">Registrarse</button>
            </form>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card p-4 p-lg-5 h-100" style="background: var(--forest); color: #fff;">
            <h3 class="mb-3" style="color: #fff;">¿Ya tienes cuenta?</h3>
            <p style="color: rgba(255,255,255,.85);">Inicia sesión para continuar disfrutando de Mundo Mascota.</p>
            <a asp-controller="Account" asp-action="Login" asp-route-returnurl="@returnUrl" class="btn btn-sun mt-2">
                Iniciar sesión
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
