<!DOCTYPE html>
@using Microsoft.Extensions.Options
@inject SignInManager<ApplicationUser> SignInManager
@inject IOptions<AlgoliaOptions> AlgoliaOptions
@{
    var algolia = AlgoliaOptions.Value;
}
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mundo Mascota</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/@@algolia/autocomplete-theme-classic/dist/theme.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/20262.styles.css" asp-append-version="true" />
</head>
<body>
    @functions {
        string NavActive(string controller, string? action = null)
        {
            var c = ViewContext.RouteData.Values["controller"]?.ToString();
            var a = ViewContext.RouteData.Values["action"]?.ToString();
            if (c != controller || (action is not null && a != action))
            {
                return string.Empty;
            }
            return "active";
        }
    }

    <header>
        <nav class="navbar navbar-expand-md navbar-light bg-white border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-area="" asp-controller="Home" asp-action="Index">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: var(--amber);">
                        <circle cx="6" cy="7.2" r="2.6" />
                        <circle cx="12" cy="4.6" r="2.6" />
                        <circle cx="18" cy="7.2" r="2.6" />
                        <path d="M12 9.8c-3 0-5.1 2.8-5.1 5.1 0 2 1.4 3.1 3.1 3.1 1 0 1.6-.3 2-.3s1 .3 2 .3c1.7 0 3.1-1.1 3.1-3.1 0-2.3-2.1-5.1-5.1-5.1Z" />
                    </svg>
                    <span class="brand-name">Mundo Mascota</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse" id="mainNav">
                    <div class="navbar-search-block d-flex flex-column flex-lg-row align-items-stretch gap-2 me-lg-3 mb-2 mb-lg-0">
                        @if (algolia.IsSearchConfigured)
                        {
                            <div id="algolia-searchbox" role="search"
                                 data-algolia-app-id="@algolia.ApplicationId"
                                 data-algolia-search-key="@algolia.ApiKeySearch"
                                 data-algolia-index="@algolia.IndexName"></div>
                        }
                        else
                        {
                            <form asp-controller="Productos" asp-action="Index" method="get" role="search" class="d-flex gap-1">
                                <input type="search" name="busqueda" class="form-control form-control-sm flex-grow-1"
                                       placeholder="Buscar producto..." aria-label="Buscar producto" />
                                <button type="submit" class="btn btn-brand btn-sm d-none d-lg-inline-block">Buscar</button>
                            </form>
                        }
                    </div>
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Home", "Index")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Productos")" asp-area="" asp-controller="Productos" asp-action="Index">Productos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Mascotas")" asp-area="" asp-controller="Mascotas" asp-action="Index">Mascotas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Todos")" asp-area="" asp-controller="Todos" asp-action="Index">Tareas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @NavActive("Home", "Contact")" asp-area="" asp-controller="Home" asp-action="Contact">Contacto</a>
                        </li>
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <span class="nav-link" style="cursor: default;">Hola, @User.Identity?.Name</span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Account", "Recordados")" asp-area="" asp-controller="Account" asp-action="Recordados">
                                    Mis recordados
                                    <span id="contador-recordados" class="badge rounded-pill ms-1" style="display: none; background: var(--forest); color: #fff;">0</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-link nav-link" style="--bs-btn-padding-x: 1.1rem;">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @NavActive("Account", "Login")" asp-area="" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                            <li class="nav-item ms-lg-1">
                                <a class="btn btn-brand btn-sm mt-1 mt-lg-0" style="border-radius: 99px;" asp-area="" asp-controller="Account" asp-action="Register">Registrarse</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container pb-5">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="container py-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-6 d-flex align-items-center gap-2">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: var(--amber);">
                        <circle cx="6" cy="7.2" r="2.6" />
                        <circle cx="12" cy="4.6" r="2.6" />
                        <circle cx="18" cy="7.2" r="2.6" />
                        <path d="M12 9.8c-3 0-5.1 2.8-5.1 5.1 0 2 1.4 3.1 3.1 3.1 1 0 1.6-.3 2-.3s1 .3 2 .3c1.7 0 3.1-1.1 3.1-3.1 0-2.3-2.1-5.1-5.1-5.1Z" />
                    </svg>
                    <div>
                        <div class="brand-name" style="font-size: 1.1rem;">Mundo Mascota</div>
                        <small>Todo para tus mejores amigos.</small>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    <a asp-controller="Home" asp-action="Index">Inicio</a> &nbsp;·&nbsp;
                    <a asp-controller="Productos" asp-action="Index">Productos</a> &nbsp;·&nbsp;
                    <a asp-controller="Mascotas" asp-action="Index">Mascotas</a> &nbsp;·&nbsp;
                    <a asp-controller="Todos" asp-action="Index">Tareas</a> &nbsp;·&nbsp;
                    <a asp-controller="Home" asp-action="Contact">Contacto</a> &nbsp;·&nbsp;
                    <a asp-controller="Home" asp-action="Privacy">Privacidad</a>
                </div>
            </div>
            <hr class="border-light opacity-25 my-3" />
            <div class="small text-center">&copy; 2026 Mundo Mascota. Hecho con cariño.</div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/algoliasearch/dist/algoliasearch-lite.umd.js" asp-append-version="true"></script>
    <script src="~/lib/@@algolia/autocomplete-js/dist/umd/index.production.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/algolia-autocomplete.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
