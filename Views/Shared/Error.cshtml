@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="page-head text-center">
    <svg width="90" height="90" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="color: var(--amber); margin: 1rem auto 0;">
        <circle cx="6" cy="7.2" r="2.6" />
        <circle cx="12" cy="4.6" r="2.6" />
        <circle cx="18" cy="7.2" r="2.6" />
        <path d="M12 9.8c-3 0-5.1 2.8-5.1 5.1 0 2 1.4 3.1 3.1 3.1 1 0 1.6-.3 2-.3s1 .3 2 .3c1.7 0 3.1-1.1 3.1-3.1 0-2.3-2.1-5.1-5.1-5.1Z" />
    </svg>
    <h1 class="display-4 mt-3">¡Ups! Algo salió mal</h1>
    <p class="lead">Ocurrió un error al procesar tu solicitud. Vuelve a intentarlo en un momento.</p>
    <a class="btn btn-brand btn-lg px-4" asp-controller="Home" asp-action="Index">Volver al inicio</a>
</div>

@if (Model.ShowRequestId)
{
    <p class="text-center mt-4 text-muted">
        <strong>ID de solicitud:</strong> <code>@Model.RequestId</code>
    </p>
}

<hr class="my-5" />

<div class="card p-4">
    <h3>Modo de desarrollo</h3>
    <p>
        Cambiar al entorno <strong>Development</strong> mostrará información más detallada sobre el error ocurrido.
    </p>
    <p>
        <strong>El entorno de desarrollo no debe estar habilitado en aplicaciones desplegadas.</strong>
        Puede mostrar información sensible de excepciones a los usuarios finales.
        Para depurar localmente, habilita el entorno <strong>Development</strong> definiendo la variable de entorno
        <strong>ASPNETCORE_ENVIRONMENT</strong> como <strong>Development</strong> y reinicia la aplicación.
    </p>
</div>
