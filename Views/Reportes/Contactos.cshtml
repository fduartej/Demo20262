@model ReporteContactosViewModel
@using _20262.Services
@inject ISentimentAnalysisService SentimentService
@{
    ViewData["Title"] = "Reporte de contactos";

    var metricas = SentimentService.UltimasMetricas;
    var negativosDestacados = Model.Negativos > 0 && Model.PorcentajeNegativo >= 50;
}

<div class="page-head">
    <span class="eyebrow">Panel de administración</span>
    <h1 class="display-4 mt-2 mb-2">Reporte de contactos</h1>
    <p>
        Mensajes recibidos el @Model.Fecha.ToString("dddd dd 'de' MMMM 'de' yyyy", new System.Globalization.CultureInfo("es"))
        clasificados automáticamente con el modelo de análisis de sentimiento.
    </p>
</div>

@if (TempData["ModeloOk"] is string modeloOk)
{
    <div class="alert alert-success" role="alert">@modeloOk</div>
}
@if (TempData["ModeloError"] is string modeloError)
{
    <div class="alert alert-danger" role="alert">@modeloError</div>
}

<div class="card p-4 mt-3">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <form asp-controller="Reportes" asp-action="Contactos" method="get"
              class="d-flex flex-wrap align-items-end gap-3 flex-grow-1">
            <div class="col-sm-6 col-lg-4">
                <label asp-for="FechaSeleccionada" class="form-label"></label>
                <input asp-for="FechaSeleccionada" class="form-control" type="date" />
            </div>
            <input type="hidden" name="filtro" value="@Model.Filtro" />
            <button type="submit" class="btn btn-brand px-4">Ver reporte</button>
            <a asp-controller="Reportes" asp-action="Contactos" asp-route-fecha="@DateTime.Today.ToString("yyyy-MM-dd")"
               asp-route-filtro="@Model.Filtro" class="btn btn-ghost">Hoy</a>
        </form>

        <form asp-controller="Reportes" asp-action="ReentrenarModelo" method="post" class="ms-lg-auto">
            <button type="submit" class="btn btn-ghost"
                    onclick="return confirm('¿Reentrenar el modelo de sentimiento con el dataset actual?');">
                Reentrenar modelo
            </button>
        </form>
    </div>
</div>

<div class="card p-4 mt-3" style="background: var(--forest); border: none;">
    <div class="row g-4">
        <div class="col-6 col-lg-3">
            <span class="stat-num">@Model.TotalMensajes</span>
            <span class="stat-label">Mensajes del día</span>
        </div>
        <div class="col-6 col-lg-3">
            <span class="stat-num">@Model.Positivos</span>
            <span class="stat-label">Positivos</span>
        </div>
        <div class="col-6 col-lg-3">
            <span class="stat-num" style="color: @(negativosDestacados ? "#FF9B9B" : "#FFFFFF");">
                @Model.Negativos
            </span>
            <span class="stat-label">Negativos</span>
        </div>
        <div class="col-6 col-lg-3">
            <span class="stat-num">@Model.ConfianzaPromedio.ToString("0.#")%</span>
            <span class="stat-label">Confianza promedio</span>
        </div>
    </div>
</div>

@if (negativosDestacados)
{
    <div class="alert alert-danger d-flex align-items-start gap-3 mt-3" role="alert">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="flex-shrink: 0;">
            <path d="M12 8v5" />
            <path d="M12 16.5h.01" />
            <path d="M10.3 3.9 2.6 17.3A2 2 0 0 0 4.3 20.3h15.4a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
        </svg>
        <div>
            El @Model.PorcentajeNegativo.ToString("0.#")% de los mensajes de hoy tienen sentimiento negativo.
            Revisa los mensajes marcados para responder cuanto antes.
        </div>
    </div>
}

<div class="d-flex flex-wrap align-items-center gap-2 mt-4 mb-3">
    <span class="fw-bold">Mensajes</span>
    <a class="filter-chip @(Model.Filtro == "todos" ? "active" : "")"
       asp-controller="Reportes" asp-action="Contactos"
       asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")" asp-route-filtro="todos">
        Todos (@Model.TotalMensajes)
    </a>
    <a class="filter-chip @(Model.Filtro == "positivos" ? "active" : "")"
       asp-controller="Reportes" asp-action="Contactos"
       asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")" asp-route-filtro="positivos">
        Positivos (@Model.Positivos)
    </a>
    <a class="filter-chip @(Model.Filtro == "negativos" ? "active" : "")"
       asp-controller="Reportes" asp-action="Contactos"
       asp-route-fecha="@Model.Fecha.ToString("yyyy-MM-dd")" asp-route-filtro="negativos">
        Negativos (@Model.Negativos)
    </a>
    @if (Model.SinClasificar > 0)
    {
        <span class="ms-auto small" style="color: var(--muted);">
            @Model.SinClasificar sin clasificar (mensajes anteriores al modelo)
        </span>
    }
</div>

@if (!Model.MensajesFiltrados.Any())
{
    <div class="card p-5 text-center">
        <p class="mb-1 fw-bold">No hay mensajes para mostrar</p>
        <p class="mb-0" style="color: var(--muted);">
            @if (Model.TotalMensajes == 0)
            {
                <text>Todavía no se han recibido mensajes de contacto el @Model.Fecha.ToString("dd/MM/yyyy").</text>
            }
            else
            {
                <text>No hay mensajes que coincidan con el filtro seleccionado.</text>
            }
        </p>
    </div>
}
else
{
    <div class="d-flex flex-column gap-3">
        @foreach (var mensaje in Model.MensajesFiltrados)
        {
            var esPositivo = mensaje.EsPositivo;
            var colorEtiqueta = mensaje.Sentimiento is null ? "var(--muted)" : (esPositivo ? "var(--forest)" : "#C0392B");
            var colorBarra = mensaje.Sentimiento is null ? "var(--line)" : (esPositivo ? "var(--forest-light)" : "#E06666");

            <article class="card card-hover p-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2">
                    <div>
                        <strong>@mensaje.Name</strong>
                        <span class="d-block small" style="color: var(--muted);">@mensaje.Email</span>
                    </div>
                    <div class="text-end">
                        <span class="badge rounded-pill" style="background: @colorEtiqueta; color: #fff; font-weight: 700;">
                            @(mensaje.Sentimiento ?? "Sin clasificar")
                        </span>
                        <span class="d-block small mt-1" style="color: var(--muted);">
                            @mensaje.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                        </span>
                    </div>
                </div>

                <p class="mt-3 mb-3">@mensaje.Message</p>

                @if (mensaje.Probabilidad is not null)
                {
                    <div class="d-flex align-items-center gap-2">
                        <div class="progress flex-grow-1" style="height: 8px;" role="progressbar"
                             aria-label="Confianza del modelo" aria-valuenow="@mensaje.Confianza"
                             aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @mensaje.Confianza.ToString("0.##")%; background: @colorBarra;"></div>
                        </div>
                        <small style="color: var(--muted); min-width: 76px; text-align: right;">
                            @(mensaje.EsPositivo ? "Positivo" : "Negativo") @mensaje.Confianza.ToString("0.#")%
                        </small>
                    </div>
                }
            </article>
        }
    </div>
}

<div class="card p-4 mt-4">
    <h2 class="h6 fw-bold mb-2">Modelo de sentimiento (ML.NET)</h2>
    <p class="mb-0 small" style="color: var(--muted);">
        Dataset: <code>ML/sentimenalAnalysisNLP/trainingdata/comentarios_entrenamiento.csv</code>
        · Modelo: <code>@System.IO.Path.GetFileName(SentimentService.ModelPath)</code>
        @if (SentimentService.EstaListo)
        {
            <text>· Cargado en memoria</text>
        }
        else
        {
            <text>· No disponible</text>
        }
        @if (metricas is not null)
        {
            <text>
                · @metricas.EjemplosTotales ejemplos (@metricas.Positivos positivos / @metricas.Negativos negativos)
                · Accuracy @metricas.Accuracy.ToString("P2")
                · Logloss @(metricas.LogLoss?.ToString("0.000") ?? "-")
                · Entrenado el @metricas.FechaEntrenamiento.ToString("dd/MM/yyyy HH:mm")
            </text>
        }
    </p>
</div>
